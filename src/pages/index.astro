---
// Copyright (c) 2026 Daniel Bates / Bates LLC. All rights reserved.
// batesav.com home page. Layout and visual language are adapted from the
// 2026-09 batesai.org redesign (hero + log card, card grid, dark service panel).
import Base from '../layouts/Base.astro';
import { SITE, mailto } from '../consts';

const services = [
  {
    id: 'sound',
    accent: 'var(--tally)',
    title: 'Live sound',
    tags: ['FOH mixing', 'Monitors', 'System tuning'],
    body: 'Clear, consistent mixes for services and events, and a console set up so the next volunteer can get there too.',
    points: ['Digital console scenes and channel layouts', 'In-ear and wedge monitor mixes', 'Room tuning, gain structure and feedback control'],
  },
  {
    id: 'video',
    accent: 'var(--blue)',
    title: 'Livestream & video',
    tags: ['Cameras', 'Streaming', 'Zoom audio'],
    body: 'A stream that sounds as good as the room: camera placement, switching, encoding and a separate broadcast mix.',
    points: ['Camera and switcher setup', 'Broadcast and Zoom audio feeds', 'Recording and posting messages online'],
  },
  {
    id: 'presentation',
    accent: 'var(--amber)',
    title: 'Presentation & lyrics',
    tags: ['ProPresenter', 'Screens', 'Slides'],
    body: 'Lyrics, sermon slides and announcements that land on every screen on time, with a workflow the whole team can follow.',
    points: ['ProPresenter libraries, themes and playlists', 'Projectors, TVs and LED wall routing', 'Stage displays and confidence monitors'],
  },
  {
    id: 'lighting',
    accent: 'var(--green)',
    title: 'Lighting',
    tags: ['Stage wash', 'Fixtures', 'Cues'],
    body: 'Stage lighting that looks good on camera and in the room, with simple, repeatable looks for each part of a service.',
    points: ['Fixture choice and placement', 'Front light for camera', 'Saved looks and simple cue lists'],
  },
  {
    id: 'planning',
    accent: 'var(--cyan)',
    title: 'System planning & purchasing',
    tags: ['Equipment lists', 'Budgets', 'Vendor quotes'],
    body: 'Moving, expanding or starting over? I turn what you need into an itemized plan with lean, expected and fully provisioned options.',
    points: ['Room walk-throughs and needs lists', 'Itemized budgets with new and used pricing', 'Reviewing integrator quotes line by line'],
  },
  {
    id: 'training',
    accent: 'var(--tally)',
    title: 'Volunteer training & docs',
    tags: ['Checklists', 'Training', 'Handoff'],
    body: 'Good systems outlast the person who built them. I write the checklists and train the people who run Sunday.',
    points: ['Start-up and shut-down checklists', 'Hands-on training for each position', 'Handoff documentation for your team'],
  },
];

const steps = [
  { n: '01', title: 'Listen and walk the room', note: 'Goals, gear, pain points' },
  { n: '02', title: 'Plan and price', note: 'Lean · expected · full' },
  { n: '03', title: 'Set up and tune', note: 'Install, test, adjust' },
  { n: '04', title: 'Train and document', note: 'Checklists your team keeps' },
  { n: '05', title: 'Stay reachable', note: 'Follow-up when things change' },
];

const systems = [
  'Digital mixing consoles',
  'Wired & wireless in-ear monitors',
  'ProPresenter',
  'Projectors, TVs & LED walls',
  'PTZ & fixed cameras',
  'Livestream & Zoom audio',
  'Stage & house lighting',
  'Audio plugins & processing',
];
---

<Base>
  <section class="wrap hero" aria-labelledby="hero-title">
    <div class="hero-copy">
      <p class="mono-label">Church &amp; venue production support</p>
      <h1 id="hero-title">Sound, screens and streams that <span class="mark">just work.</span></h1>
      <p class="lede">{SITE.name} helps churches and small venues run live sound, livestreams, lighting and ProPresenter with confidence, from planning a new system to training the volunteers who run it every week.</p>
      <div class="hero-actions">
        <a class="button primary" href={mailto()}>Talk about your setup
          <svg viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M3.5 5.5h13v9h-13zM4 6l6 5 6-5" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </a>
        <a class="button secondary" href="#services">See services
          <svg viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M10 4v12M5 11l5 5 5-5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </a>
      </div>
    </div>

    <div class="hero-art" aria-hidden="true">
      <div class="shape one"></div><div class="shape two"></div><div class="shape three"></div>
      <div class="console">
        <div class="console-head"><span>sunday_service.run</span><span class="tally-dot">LIVE</span></div>
        <span class="line"><b class="ok">●</b> mics line-checked</span>
        <span class="line"><b class="info">◆</b> lyrics → screens</span>
        <span class="line"><b class="ok">●</b> stream mix → online</span>
        <span class="line dim">↳ volunteers ready at 8:30</span>
        <div class="meters">
          {Array.from({ length: 8 }, (_, i) => <i style={`--d:${(i * 0.37) % 1.6}s;--h:${[62, 80, 48, 92, 70, 55, 86, 40][i]}%`}></i>)}
        </div>
      </div>
    </div>
  </section>

  <section class="wrap overview" id="services" aria-labelledby="services-title">
    <h2 id="services-title">Production help for teams that run on volunteers.</h2>
    <p>Hands-on help with the whole signal chain: microphones to speakers, cameras to the stream, lyrics to every screen.</p>
  </section>

  <div class="wrap service-grid">
    {services.map((s) => (
      <article class="service-card" id={s.id} style={`--accent:${s.accent}`}>
        <div class="card-top">
          <span class="dot" aria-hidden="true"></span>
          <h3>{s.title}</h3>
        </div>
        <div class="card-tags">{s.tags.map((t) => <span class="tag">{t}</span>)}</div>
        <p>{s.body}</p>
        <ul>{s.points.map((p) => <li>{p}</li>)}</ul>
      </article>
    ))}
  </div>

  <section class="wrap approach" id="approach" aria-labelledby="approach-title">
    <div>
      <p class="mono-label on-dark">How it works</p>
      <h2 id="approach-title">A plan you can afford, and a team that can run it.</h2>
      <p>Every room and budget is different. I start with what you already own, price options at a few levels so you can choose, and leave you with documentation, not dependence.</p>
    </div>
    <ol class="step-list">
      {steps.map((s) => (
        <li class="step-row"><span class="step-n">{s.n}</span><span class="step-title">{s.title}</span><span class="step-note">{s.note}</span></li>
      ))}
    </ol>
  </section>

  <section class="wrap tools" id="tools" aria-labelledby="tools-title">
    <header class="section-head">
      <h2 id="tools-title">Tools and systems</h2>
      <p>Familiar with the gear most churches already have, and building software where off-the-shelf tools fall short.</p>
    </header>
    <div class="tools-grid">
      <article class="tool-card">
        <div class="tool-visual" aria-hidden="true">
          <div class="lyric-card">
            <span class="lyric-label">Now singing</span>
            <span class="lyric-line">Lyric recognized</span>
            <span class="lyric-next">→ slide advanced automatically</span>
          </div>
        </div>
        <div class="tool-body">
          <div class="card-tags"><span class="tag">ProPresenter</span><span class="tag">Open source</span><span class="tag">macOS</span></div>
          <h3>AutoLyrics for ProPresenter</h3>
          <p>Listens to the room, recognizes the lyric being sung and advances ProPresenter slides in real time, so a missed cue does not leave the congregation guessing.</p>
          <a class="text-link" href="https://github.com/danielalanbates/auto-lyrics-pro-presenter" target="_blank" rel="noopener">View on GitHub
            <svg viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M7 13 13 7M8 7h5v5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </a>
        </div>
      </article>
      <article class="systems-card" aria-labelledby="systems-title">
        <h3 id="systems-title">Systems I work with</h3>
        <ul class="systems-list">{systems.map((s) => <li>{s}</li>)}</ul>
      </article>
    </div>
  </section>

  <section class="wrap about" id="about" aria-labelledby="about-title">
    <p class="mono-label">About</p>
    <div class="about-grid">
      <h2 id="about-title">Hi, I’m {SITE.owner}.</h2>
      <div class="about-copy">
        <p>I’m a church technical manager in the {SITE.region}. Every week I run and maintain sound, video, lighting and presentation for live services, and I plan the equipment, budgets and moves behind them.</p>
        <p>I also build software at <a href={SITE.sister.url} rel="noopener">{SITE.sister.name}</a>, which is where tools like AutoLyrics come from. {SITE.name} brings both together: practical AV help, honest advice on what to buy (and what not to), and systems your team can run without me.</p>
      </div>
    </div>
  </section>

  <section class="wrap contact" id="contact" aria-labelledby="contact-title">
    <h2 id="contact-title">Tell me about your room.</h2>
    <div class="contact-copy">
      <p>Send a short note with your venue, roughly how many people you serve, the gear you have now, and what is not working. I’ll reply with next steps.</p>
      <div class="contact-actions">
        <a class="button primary" href={mailto()}>Start a conversation
          <svg viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M3.5 5.5h13v9h-13zM4 6l6 5 6-5" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </a>
        <a class="contact-email" href={mailto()}>{SITE.email}</a>
      </div>
    </div>
  </section>
</Base>

<style>
  /* Hero */
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1.18fr) minmax(300px, .82fr);
    gap: 50px; align-items: center;
    min-height: 560px;
    padding: 88px 0 72px;
    border-bottom: 1px solid var(--line);
  }
  .hero-copy { max-width: 730px; }
  h1 {
    margin-bottom: 24px;
    font-size: clamp(44px, 7vw, 84px);
    line-height: .98; letter-spacing: -.055em; font-weight: 800;
  }
  .mark { position: relative; white-space: nowrap; z-index: 0; }
  .mark::after {
    content: ""; position: absolute; z-index: -1;
    left: -.04em; right: -.06em; bottom: .08em; height: .22em;
    background: var(--tally-soft); transform: rotate(-1deg);
  }
  .lede { max-width: 610px; margin-bottom: 30px; color: var(--muted); font-size: clamp(17px, 2vw, 20px); }
  .hero-actions { display: flex; flex-wrap: wrap; gap: 12px; }

  .hero-art { position: relative; min-height: 400px; }
  .shape { position: absolute; opacity: .85; }
  .shape.one { width: 26px; height: 26px; right: 30px; top: 60px; border-radius: 50%; background: var(--tally); }
  .shape.two { width: 24px; height: 24px; left: 30px; bottom: 70px; background: var(--blue); transform: rotate(13deg); }
  .shape.three { width: 28px; height: 28px; left: 60px; top: 50px; border-radius: 50%; border: 6px solid var(--amber); }
  .console {
    position: absolute; right: 40px; top: 110px;
    width: min(330px, 80%);
    padding: 18px 18px 16px;
    background: #141714; color: #f1f5ee;
    border: 1px solid #3b423b; border-radius: 12px;
    box-shadow: 0 24px 54px rgba(0, 0, 0, .22);
    transform: rotate(-3deg);
    font: 500 12px/1.7 var(--mono);
  }
  .console-head { display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px; color: #aeb8ab; }
  .tally-dot {
    padding: 2px 7px; border-radius: 4px;
    background: #e8432e; color: #fff; font-weight: 600; font-size: 10px; letter-spacing: .08em;
    animation: blink 2.4s ease-in-out infinite;
  }
  .line { display: block; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .line b { font-weight: 600; }
  .ok { color: #5fd88a; }
  .info { color: #8fa9ff; }
  .dim { color: #8a9588; }
  .meters { display: flex; align-items: flex-end; gap: 5px; height: 46px; margin-top: 14px; }
  .meters i {
    flex: 1; height: var(--h); border-radius: 2px;
    background: linear-gradient(to top, #3fbf6a 0 60%, #ffb627 60% 85%, #e8432e 85%);
    transform-origin: bottom;
    animation: level 1.6s ease-in-out infinite alternate;
    animation-delay: calc(var(--d) * -1);
  }
  @keyframes level { from { transform: scaleY(.35); } to { transform: scaleY(1); } }
  @keyframes blink { 0%, 100% { opacity: 1; } 50% { opacity: .55; } }

  /* Overview + services */
  .overview {
    display: grid; grid-template-columns: 1.35fr .65fr; gap: 44px; align-items: end;
    padding: 64px 0 36px;
  }
  .overview h2, .section-head h2 {
    margin-bottom: 0; font-size: clamp(30px, 4vw, 48px); line-height: 1.05; letter-spacing: -.045em;
  }
  .overview p, .section-head p { margin-bottom: 0; color: var(--muted); }
  .service-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 18px; padding-bottom: 80px; }
  .service-card {
    display: flex; flex-direction: column;
    padding: 24px;
    background: var(--panel);
    border: 1px solid var(--line); border-top: 4px solid var(--accent);
    border-radius: var(--radius);
    box-shadow: 0 5px 22px rgba(30, 36, 30, .04);
  }
  .card-top { display: flex; align-items: center; gap: 10px; margin-bottom: 12px; }
  .dot { width: 11px; height: 11px; background: var(--accent); transform: rotate(45deg); flex: none; }
  .service-card h3, .tool-body h3, .systems-card h3 { margin: 0; font-size: 22px; line-height: 1.1; letter-spacing: -.03em; }
  .card-tags { display: flex; flex-wrap: wrap; gap: 6px; margin-bottom: 14px; }
  .service-card p { color: var(--muted); margin-bottom: 14px; }
  .service-card ul { margin: auto 0 0; padding: 14px 0 0; border-top: 1px solid var(--line); list-style: none; display: grid; gap: 6px; font-size: 14px; }
  .service-card li { position: relative; padding-left: 16px; }
  .service-card li::before { content: ""; position: absolute; left: 0; top: .62em; width: 7px; height: 2px; background: var(--accent); }

  /* Approach (dark panel) */
  .approach {
    position: relative; overflow: hidden;
    display: grid; grid-template-columns: 1fr 1fr; gap: 34px 56px; align-items: start;
    margin-bottom: 90px; padding: 44px;
    background: var(--dark-panel); color: #f2f4ef;
    border-radius: 14px;
  }
  .approach h2 { margin-bottom: 12px; font-size: clamp(30px, 4vw, 46px); line-height: 1.05; letter-spacing: -.045em; }
  .approach p { max-width: 520px; margin-bottom: 0; color: var(--dark-muted); }
  .mono-label.on-dark { color: var(--dark-muted); }
  .step-list { display: grid; gap: 1px; margin: 0; padding: 0; list-style: none; background: var(--dark-line); border: 1px solid var(--dark-line); }
  .step-row { display: grid; grid-template-columns: auto 1fr auto; gap: 16px; align-items: baseline; padding: 15px 16px; background: var(--dark-row); }
  .step-n { color: #ff6b55; font: 600 12px/1 var(--mono); }
  .step-title { font-weight: 700; }
  .step-note { color: var(--dark-muted); font-size: 13px; text-align: right; }

  /* Tools */
  .tools { padding-bottom: 80px; }
  .section-head { display: grid; grid-template-columns: minmax(220px, .7fr) 1.3fr; gap: 32px; align-items: end; margin-bottom: 26px; }
  .tools-grid { display: grid; grid-template-columns: 7fr 5fr; gap: 18px; }
  .tool-card, .systems-card {
    overflow: hidden;
    background: var(--panel); border: 1px solid var(--line); border-radius: var(--radius);
  }
  .tool-card { display: grid; grid-template-rows: auto 1fr; }
  .tool-visual {
    display: grid; place-items: center; min-height: 200px; padding: 26px;
    background: #1d2340;
  }
  .lyric-card {
    display: grid; gap: 4px; width: min(320px, 100%); padding: 18px 20px;
    background: #0e1226; color: #fff; border: 1px solid #39407a; border-radius: 10px;
    box-shadow: 0 18px 40px rgba(0, 0, 0, .3);
  }
  .lyric-label { color: #ffb627; font: 600 10px/1.4 var(--mono); letter-spacing: .1em; text-transform: uppercase; }
  .lyric-line { font-size: 24px; font-weight: 800; letter-spacing: -.03em; }
  .lyric-next { color: #a9b4ff; font: 500 12px/1.5 var(--mono); }
  .tool-body { display: flex; flex-direction: column; padding: 24px; }
  .tool-body h3 { margin-bottom: 10px; }
  .tool-body p { color: var(--muted); margin-bottom: 18px; }
  .text-link {
    align-self: flex-start; margin-top: auto;
    display: inline-flex; align-items: center; gap: 8px; min-height: 44px;
    font-weight: 800; font-size: 14px; text-underline-offset: 4px;
  }
  .text-link svg { width: 16px; height: 16px; }
  .text-link:hover { color: var(--tally); }
  .systems-card { padding: 24px; }
  .systems-card h3 { margin-bottom: 16px; }
  .systems-list { display: grid; gap: 0; margin: 0; padding: 0; list-style: none; }
  .systems-list li {
    display: flex; align-items: center; gap: 12px;
    padding: 11px 0; border-top: 1px solid var(--line); font-weight: 600;
  }
  .systems-list li::before { content: ""; width: 8px; height: 8px; border-radius: 50%; background: var(--green); flex: none; }

  /* About */
  .about { padding: 64px 0; border-top: 1px solid var(--line); }
  .about-grid { display: grid; grid-template-columns: minmax(220px, .72fr) minmax(0, 1.28fr); gap: 42px; }
  .about h2 { margin: 0; font-size: clamp(32px, 4.5vw, 52px); line-height: 1; letter-spacing: -.05em; }
  .about-copy { max-width: 640px; color: var(--muted); font-size: 17px; }
  .about-copy a { color: var(--ink); font-weight: 700; text-underline-offset: 3px; }

  /* Contact */
  .contact {
    display: grid; grid-template-columns: minmax(220px, .72fr) minmax(0, 1.28fr); gap: 42px; align-items: start;
    padding: 64px 0 72px; border-top: 1px solid var(--line);
  }
  .contact h2 { margin: 0; font-size: clamp(34px, 5vw, 56px); line-height: 1; letter-spacing: -.05em; }
  .contact-copy { max-width: 620px; }
  .contact-copy > p { margin-bottom: 24px; color: var(--muted); font-size: 17px; }
  .contact-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 14px 18px; }
  .contact-email { color: var(--ink); font: 600 13px/1.4 var(--mono); text-underline-offset: 4px; overflow-wrap: anywhere; }

  @media (max-width: 960px) {
    .service-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .tools-grid { grid-template-columns: 1fr; }
  }
  @media (max-width: 800px) {
    .hero { grid-template-columns: 1fr; gap: 16px; min-height: auto; padding: 56px 0 44px; }
    .hero-art { min-height: 320px; width: min(440px, 100%); margin: 0 auto; }
    .console { right: 24px; top: 70px; }
    .overview, .section-head, .about-grid, .contact { grid-template-columns: 1fr; gap: 16px; }
    .overview { padding: 48px 0 28px; }
    .approach { grid-template-columns: 1fr; padding: 32px 22px; }
    .step-row { grid-template-columns: auto 1fr; }
    .step-note { grid-column: 2; text-align: left; }
  }
  @media (max-width: 600px) {
    .service-grid { grid-template-columns: 1fr; }
  }
  @media (max-width: 480px) {
    h1 { font-size: clamp(40px, 13vw, 56px); }
    .hero-actions { display: grid; }
    .button { width: 100%; }
    .hero-art { min-height: 290px; }
    .console { width: min(290px, 86%); right: 12px; font-size: 11px; }
    .service-card, .tool-body, .systems-card { padding: 20px; }
  }
</style>
