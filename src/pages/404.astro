import Base from '../layouts/Base.astro';
---

<Base title="Page not found — Bates AV" noindex>
  <section class="wrap missing">
    <p class="mono-label">404 · no signal</p>
    <h1>This page isn’t patched in.</h1>
    <p>The link may be old or mistyped. Head back to the home page and try again.</p>
    <a class="button primary" href="/">Back to home</a>
  </section>
</Base>

<style>
  .missing { padding: 110px 0 120px; max-width: 720px; }
  h1 { font-size: clamp(38px, 6vw, 68px); line-height: 1; letter-spacing: -.05em; margin-bottom: 18px; }
  p:not(.mono-label) { color: var(--muted); font-size: 18px; margin-bottom: 28px; }
</style>
