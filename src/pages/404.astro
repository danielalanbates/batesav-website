import Base from '../layouts/Base.astro';
---

<Base title="Page not found — Bates AV" noindex>
  <section class="measure missing">
    <svg class="flatline" viewBox="0 0 200 40" aria-hidden="true">
      <path d="M2 20H86l6-10 8 20 6-10H198" />
    </svg>
    <p class="kicker">Page 404 — no signal</p>
    <h1>This page isn’t patched in.</h1>
    <p class="note">The link may be old or mistyped. Head back to the home page and try again.</p>
    <a class="button" href="/">Back to home</a>
  </section>
</Base>

<style>
  .missing {
    display: grid; justify-items: center; align-content: center; text-align: center;
    min-height: 60vh; padding: 80px 0 96px;
  }
  .flatline { width: 200px; height: 40px; margin-bottom: 24px; fill: none; stroke: var(--accent); stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }
  h1 { max-width: 16ch; margin-bottom: 18px; font-size: clamp(36px, 5vw, 60px); font-weight: 500; line-height: 1.08; }
  .note { max-width: 44ch; margin-bottom: 30px; color: var(--muted); font-size: 19px; }
</style>
