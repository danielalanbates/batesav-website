---
// Copyright (c) 2026 Daniel Bates / Bates LLC. All rights reserved.
// Shared page shell: head metadata, masthead, footer and the shared wave symbol.
import '../styles/global.css';
import { SITE, mailto } from '../consts';

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
}

const {
  title = `${SITE.name} — Live sound, event recording & broadcast audio in the Tri-Cities`,
  description = SITE.description,
  noindex = false,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL('/og.png', Astro.site).href;
const year = 2026;

const nav = [
  { href: '/#services', label: 'Services' },
  { href: '/#packages', label: 'Packages' },
  { href: '/#approach', label: 'How it works' },
  { href: '/#next', label: 'Coming soon' },
  { href: '/#about', label: 'About' },
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  name: SITE.name,
  url: SITE.url,
  description: SITE.description,
  email: SITE.email,
  areaServed: SITE.region,
  serviceType: ['Live sound', 'Event audio recording', 'Broadcast audio'],
  founder: { '@type': 'Person', name: SITE.owner, sameAs: [SITE.linkedin, SITE.github] },
  parentOrganization: { '@type': 'Organization', name: SITE.company, url: SITE.sister.url },
};
---

<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <meta name="color-scheme" content="light dark" />
  <meta name="description" content={description} />
  {noindex && <meta name="robots" content="noindex" />}
  <title>{title}</title>
  <link rel="canonical" href={canonicalURL} />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <meta name="theme-color" media="(prefers-color-scheme: light)" content="#f5eddf" />
  <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#1a1612" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght,SOFT@0,9..144,400..700,50;1,9..144,400..600,50&family=Source+Sans+3:ital,wght@0,400;0,600;0,700;1,400&display=swap" rel="stylesheet" />

  <meta property="og:type" content="website" />
  <meta property="og:site_name" content={SITE.name} />
  <meta property="og:url" content={canonicalURL} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={ogImage} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content={`${SITE.name} — ${SITE.tagline}`} />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImage} />

  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
</head>
<body>
  <!-- One canonical wave path, reused everywhere via <use href="#wave">. -->
  <svg width="0" height="0" style="position:absolute" aria-hidden="true" focusable="false">
    <symbol id="wave" viewBox="0 0 120 16">
      <path d="M2 8 C 14 2, 26 2, 38 8 S 62 14, 74 8 S 98 2, 118 8" vector-effect="non-scaling-stroke" />
    </symbol>
  </svg>

  <a class="skip-link" href="#main">Skip to content</a>

  <header class="masthead">
    <nav class="measure mast-inner" aria-label="Main">
      <a class="wordmark" href="/" aria-label={`${SITE.name} home`}>
        Bates<span class="av">AV<svg class="wave" aria-hidden="true"><use href="#wave" /></svg></span>
      </a>
      <ul class="mast-links">
        {nav.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
        <li class="mast-cta">
          <a href="/#contact">
            <svg viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M3.5 5.5h13v9h-13zM4 6l6 5 6-5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
            Check a date
          </a>
        </li>
      </ul>
    </nav>
    <div class="measure double-rule" aria-hidden="true"></div>
  </header>

  <main id="main">
    <slot />
  </main>

  <footer class="site-footer">
    <div class="measure double-rule" aria-hidden="true"></div>
    <div class="measure footer-inner">
      <div class="footer-id">
        <p class="wordmark small">Bates<span class="av">AV<svg class="wave" aria-hidden="true"><use href="#wave" /></svg></span></p>
        <p class="footer-note">Live sound, event recording and broadcast audio from the {SITE.region}. Founded by {SITE.owner}.</p>
      </div>
      <ul class="footer-links">
        <li><a href={mailto()}>{SITE.email}</a></li>
        <li><a href={SITE.linkedin} target="_blank" rel="noopener">LinkedIn</a></li>
        <li><a href={SITE.sister.url} rel="noopener">{SITE.sister.name}</a></li>
        <li><a href={SITE.github} target="_blank" rel="noopener">GitHub</a></li>
      </ul>
      <div class="footer-colophon">
        <p class="smallcaps">Set in Fraunces &amp; Source Sans 3</p>
        <a href="#main">Back to top&nbsp;<span aria-hidden="true">↑</span></a>
      </div>
      <p class="footer-legal smallcaps">&copy; {year} {SITE.owner} / {SITE.company}. All rights reserved.</p>
    </div>
  </footer>
</body>
</html>

<style>
  .masthead { padding-top: env(safe-area-inset-top); }
  .mast-inner {
    display: flex; align-items: center; justify-content: space-between; gap: 24px;
    min-height: 80px;
  }
  .wordmark {
    margin: 0;
    color: var(--ink); text-decoration: none;
    font: 600 26px/1 var(--serif); letter-spacing: 0;
  }
  .wordmark .av {
    position: relative; display: inline-block; margin-left: .12em;
    color: var(--primary); font-style: italic; font-weight: 500;
  }
  .wordmark .av svg {
    position: absolute; left: 0; bottom: -9px; width: 100%; height: 8px;
    color: var(--accent); stroke-width: 2;
  }
  .wordmark.small { font-size: 22px; }

  .mast-links {
    display: flex; align-items: center; flex-wrap: wrap; justify-content: center;
    gap: 0 4px; margin: 0; padding: 0; list-style: none;
  }
  .mast-links li { display: flex; align-items: center; }
  .mast-links li + li:not(.mast-cta)::before {
    content: "·" / ""; color: var(--accent-text); padding: 0 6px; font-weight: 700;
  }
  .mast-links a {
    display: inline-flex; align-items: center; gap: 8px; min-height: 44px; padding: 0 6px;
    color: var(--ink); text-decoration: none; font: 600 16px/1.2 var(--sans);
  }
  .mast-links a:hover, .mast-links a:focus-visible {
    color: var(--primary);
    text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: 6px;
  }
  .mast-cta { margin-left: 18px; }
  .mast-cta a { color: var(--primary); font: italic 500 18px/1.2 var(--serif); }
  .mast-cta svg { width: 16px; height: 16px; }

  .double-rule {
    height: 5px;
    border-top: 1px solid var(--rule); border-bottom: 1px solid var(--rule);
  }

  .site-footer { margin-top: 0; }
  .footer-inner {
    display: grid; grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr) minmax(0, 1fr);
    gap: 24px 40px;
    padding: 40px 0 max(40px, env(safe-area-inset-bottom));
    color: var(--muted); font-size: 16px;
  }
  .footer-note { margin: 14px 0 0; max-width: 40ch; }
  .footer-links { display: grid; gap: 0; margin: 0; padding: 0; list-style: none; align-content: start; }
  .footer-links a, .footer-colophon a {
    display: inline-flex; align-items: center; min-height: 44px;
    color: var(--ink); font-weight: 600; overflow-wrap: anywhere;
    text-decoration-thickness: 1px; text-underline-offset: 5px;
  }
  .footer-links a:hover, .footer-colophon a:hover { color: var(--primary); }
  .footer-colophon p { margin: 10px 0 0; font-size: 15px; }
  .footer-legal { grid-column: 1 / -1; margin: 8px 0 0; font-size: 15px; }

  @media (max-width: 1040px) {
    .mast-inner { flex-direction: column; justify-content: center; gap: 10px; padding: 22px 0 10px; }
    .mast-cta { margin-left: 10px; }
  }
  @media (max-width: 700px) {
    .footer-inner { grid-template-columns: 1fr; text-align: center; justify-items: center; }
    .footer-note { margin-inline: auto; }
    .footer-links { justify-items: center; }
  }
  @media (max-width: 700px) {
    .mast-links { gap: 0 6px; }
    .mast-links li + li:not(.mast-cta)::before { content: none; }
  }
  @media (max-width: 420px) {
    .mast-links { gap: 0; }
    .mast-links a { padding: 0 7px; font-size: 15px; }
    .mast-cta { margin-left: 0; width: 100%; justify-content: center; }
  }
</style>
