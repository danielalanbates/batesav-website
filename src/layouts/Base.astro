---
// Copyright (c) 2026 Daniel Bates / Bates LLC. All rights reserved.
// Shared page shell: head metadata, top nav, footer. Every page uses this.
import '../styles/global.css';
import { SITE, mailto } from '../consts';

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
}

const {
  title = `${SITE.name} — Live sound, video & presentation for churches and venues`,
  description = SITE.description,
  noindex = false,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site).href;
const year = 2026;

const nav = [
  { href: '/#services', label: 'Services' },
  { href: '/#approach', label: 'Approach' },
  { href: '/#tools', label: 'Tools' },
  { href: '/#about', label: 'About' },
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  name: SITE.name,
  url: SITE.url,
  description: SITE.description,
  email: SITE.email,
  areaServed: SITE.region,
  founder: { '@type': 'Person', name: SITE.owner, sameAs: [SITE.github] },
  parentOrganization: { '@type': 'Organization', name: SITE.company, url: SITE.sister.url },
};
---

<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <meta name="color-scheme" content="light dark" />
  <meta name="description" content={description} />
  {noindex && <meta name="robots" content="noindex" />}
  <title>{title}</title>
  <link rel="canonical" href={canonicalURL} />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <meta name="theme-color" content="#121412" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@500;600&family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet" />

  <meta property="og:type" content="website" />
  <meta property="og:site_name" content={SITE.name} />
  <meta property="og:url" content={canonicalURL} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={new URL('/og.png', Astro.site).href} />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={new URL('/og.png', Astro.site).href} />

  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
</head>
<body>
  <a class="skip-link" href="#main">Skip to content</a>

  <header class="site-nav">
    <nav class="wrap nav-inner" aria-label="Main">
      <a class="brand" href="/" aria-label={`${SITE.name} home`}>
        <span class="brand-mark" aria-hidden="true"><i></i><i></i><i></i><i></i></span>
        <span class="brand-name">Bates<span>AV</span></span>
      </a>
      <ul class="nav-links">
        {nav.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
      </ul>
      <a class="nav-cta" href="/#contact">Get in touch</a>
    </nav>
  </header>

  <main id="main">
    <slot />
  </main>

  <footer class="site-footer">
    <div class="wrap footer-inner">
      <div>
        <p class="footer-brand">Bates<span>AV</span></p>
        <p class="footer-note">Live sound, video and presentation systems by {SITE.owner}, {SITE.region}.</p>
      </div>
      <ul class="footer-links">
        <li><a href={mailto()}>{SITE.email}</a></li>
        <li><a href={SITE.sister.url} rel="noopener">{SITE.sister.name}</a></li>
        <li><a href={SITE.github} target="_blank" rel="noopener">GitHub</a></li>
      </ul>
      <p class="footer-legal">&copy; {year} {SITE.owner} / {SITE.company}. All rights reserved.</p>
    </div>
  </footer>
</body>
</html>

<style>
  .site-nav {
    position: sticky; top: 0; z-index: 20;
    padding-top: env(safe-area-inset-top);
    background: var(--nav);
    border-bottom: 1px solid var(--line);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
  }
  .nav-inner { display: flex; align-items: center; gap: 22px; min-height: 64px; }
  .brand { display: inline-flex; align-items: center; gap: 10px; text-decoration: none; }
  .brand-mark { display: inline-flex; align-items: flex-end; gap: 3px; height: 22px; }
  .brand-mark i { width: 4px; border-radius: 2px; background: var(--ink); }
  .brand-mark i:nth-child(1) { height: 40%; }
  .brand-mark i:nth-child(2) { height: 100%; background: var(--tally); }
  .brand-mark i:nth-child(3) { height: 65%; }
  .brand-mark i:nth-child(4) { height: 30%; }
  .brand-name, .footer-brand { font-size: 21px; font-weight: 800; letter-spacing: -.04em; }
  .brand-name span, .footer-brand span { color: var(--tally); }
  .nav-links { display: flex; gap: 4px; margin: 0 0 0 auto; padding: 0; list-style: none; }
  .nav-links a {
    display: inline-flex; align-items: center; min-height: 40px; padding: 8px 12px;
    border-radius: 100px; color: var(--muted); text-decoration: none;
    font-size: 14px; font-weight: 700;
  }
  .nav-links a:hover { color: var(--ink); background: var(--paper-2); }
  .nav-cta {
    display: inline-flex; align-items: center; min-height: 40px; padding: 8px 16px;
    border: 1px solid var(--ink); border-radius: 100px;
    color: var(--paper); background: var(--ink); text-decoration: none;
    font-size: 14px; font-weight: 800;
  }
  .nav-cta:hover { background: var(--tally); border-color: var(--tally); color: #121412; }

  .site-footer { border-top: 1px solid var(--line); margin-top: 24px; }
  .footer-inner {
    display: grid; grid-template-columns: 1fr auto; gap: 18px 32px;
    padding: 36px 0 max(40px, env(safe-area-inset-bottom));
    color: var(--muted); font-size: 14px;
  }
  .footer-brand { margin: 0 0 6px; color: var(--ink); }
  .footer-note { margin: 0; max-width: 460px; }
  .footer-links { display: flex; flex-wrap: wrap; gap: 8px 20px; margin: 0; padding: 0; list-style: none; align-self: start; }
  .footer-links a { color: var(--ink); font-weight: 700; text-underline-offset: 3px; }
  .footer-legal { grid-column: 1 / -1; margin: 8px 0 0; font: 500 12px/1.4 var(--mono); }

  @media (max-width: 760px) {
    .nav-inner { flex-wrap: wrap; gap: 4px 12px; padding: 10px 0 6px; }
    .nav-cta { margin-left: auto; }
    .nav-links {
      order: 3; width: 100%; margin: 0 -8px; overflow-x: auto;
      scrollbar-width: none;
    }
    .nav-links::-webkit-scrollbar { display: none; }
    .nav-links a { min-height: 36px; padding: 6px 10px; font-size: 13px; white-space: nowrap; }
    .nav-links a:focus-visible { outline-offset: -3px; }
    .footer-inner { grid-template-columns: 1fr; }
  }
</style>
